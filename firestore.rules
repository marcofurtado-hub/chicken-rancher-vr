rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ranking mundial do Chicken Rancher: qualquer um lê; só dá para CRIAR uma pontuação
    // com formato válido. Ninguém edita nem apaga pelo jogo.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'wave', 'won', 't', 'v'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 3000000
        && request.resource.data.wave is int && request.resource.data.wave >= 1 && request.resource.data.wave <= 10
        && request.resource.data.won is bool
        && request.resource.data.t == request.time
        && request.resource.data.v is string && request.resource.data.v.size() <= 8;
      allow update, delete: if false;
    }
  }
}
